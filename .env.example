# ==============================================================================
# AI Video Assistant - Environment Configuration
# ==============================================================================

# Mistral AI API key for LLM generation and Text Embeddings
# Obtain from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Whisper Model Configuration
# Options: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small

# Optional: Custom Whisper model download root (defaults to D:\whisper_models or user cache)
# WHISPER_DOWNLOAD_ROOT=D:\whisper_models
